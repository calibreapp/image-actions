{
  "name": "image-actions",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "entrypoint.ts",
  "author": "Calibre <hello@calibreapp.com>",
  "license": "ISC",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "GITHUB_WORKSPACE=__tests__/test-images vitest run",
    "test:watch": "GITHUB_WORKSPACE=__tests__/test-images vitest",
    "test:docker": "docker compose -f docker-compose.test.yml build && docker compose -f docker-compose.test.yml run test",
    "docker:build": "docker build . --tag image-actions:latest",
    "format": "prettier --write **/*.{js,ts}",
    "format-check": "prettier --check **/*.{js,ts}",
    "lint": "eslint 'src/**/*.ts' entrypoint.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:docker"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none",
    "arrowParens": "avoid"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@octokit/action": "^8.0.4",
    "ejs": "^7.0.2",
    "p-throttle": "^8.1.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.7",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
